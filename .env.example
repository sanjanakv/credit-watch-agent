# Never commit real keys. In Cursor cloud agents, add XAI_API_KEY under
# cursor.com/dashboard/cloud-agents -> Secrets (injected when an agent starts).
XAI_API_KEY=
# Default is the global endpoint. Use https://us.api.x.ai/v1 to keep request handling/inference in the US
# (grok-4.7 and grok-4.6 only; server-side tools are outside that guarantee).
XAI_BASE_URL=https://api.x.ai/v1
